{
  "name": "editor-console-toolkit",
  "displayName": "Editor Console Toolkit",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "HeavenSky",
  "license": "MIT",
  "icon": "media/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeavenSky/editor-console-toolkit.git"
  },
  "homepage": "https://github.com/HeavenSky/editor-console-toolkit",
  "bugs": {
    "url": "https://github.com/HeavenSky/editor-console-toolkit/issues"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.15.1"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "console",
    "log",
    "debug",
    "toggle log",
    "multi language",
    "developer tools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "editorConsoleToolkit.insertConsoleLog",
        "title": "%command.insertConsoleLog%",
        "category": "%category%"
      },
      {
        "command": "editorConsoleToolkit.toggleConsoleLog",
        "title": "%command.toggleConsoleLog%",
        "category": "%category%"
      },
      {
        "command": "editorConsoleToolkit.toggleAllConsoleLogs",
        "title": "%command.toggleAllConsoleLogs%",
        "category": "%category%"
      }
    ],
    "keybindings": [
      {
        "command": "editorConsoleToolkit.insertConsoleLog",
        "key": "alt+l",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Editor Console Toolkit",
      "properties": {
        "editorConsoleToolkit.prefix": {
          "type": "string",
          "default": "🎯🎯🎯 [DEBUG]",
          "maxLength": 80,
          "scope": "language-overridable",
          "description": "%config.prefix%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs",
    "build": "node build.mjs --production",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
