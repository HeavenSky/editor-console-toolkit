{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",
	"arrowParens": "avoid",
	"ignorePatterns": ["*.min.*", "package-lock.json", "test/fixtures/**"],
	"jsxSingleQuote": false,
	"objectWrap": "collapse",
	"singleQuote": false,
	"tabWidth": 4,
	"trailingComma": "es5",
	"useTabs": true
}
